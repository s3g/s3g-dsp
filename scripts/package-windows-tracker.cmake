# Cross-build packaging only; never installs or replaces an existing package.
cmake_minimum_required(VERSION 3.20)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED build_dir)
  set(build_dir "${repo}/build-clap-windows-cross")
endif()
find_program(objdump x86_64-w64-mingw32-objdump REQUIRED)
find_program(strip x86_64-w64-mingw32-strip REQUIRED)
set(binary_dir "${build_dir}/plugins/clap_tracker")
foreach(binary s3g_tracker.clap s3g_tracker_windows_clap_smoke.exe)
  execute_process(COMMAND "${objdump}" -p "${binary_dir}/${binary}"
    OUTPUT_VARIABLE pe ERROR_VARIABLE error RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR NOT pe MATCHES "pei-x86-64"
      OR pe MATCHES "DLL Name: (libgcc|libstdc[+][+]|libwinpthread)")
    message(FATAL_ERROR "Invalid Windows binary or external compiler runtime: ${binary}\n${error}")
  endif()
  if(binary STREQUAL "s3g_tracker.clap" AND NOT pe MATCHES "clap_entry")
    message(FATAL_ERROR "Missing CLAP entry export")
  endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
set(name "s3g-tracker-windows-x64-test-${stamp}")
set(staging "${repo}/dist/${name}")
if(EXISTS "${staging}" OR EXISTS "${staging}.zip")
  message(FATAL_ERROR "Refusing to overwrite an existing package")
endif()
file(MAKE_DIRECTORY "${staging}/Resources/Fonts")
foreach(binary s3g_tracker.clap s3g_tracker_windows_clap_smoke.exe)
  configure_file("${binary_dir}/${binary}" "${staging}/${binary}" COPYONLY)
  execute_process(COMMAND "${strip}" --strip-unneeded "${staging}/${binary}"
    COMMAND_ERROR_IS_FATAL ANY)
endforeach()
foreach(font FiraCode-Regular.ttf FiraCode-LICENSE.txt
    IBMPlexMono-Regular.ttf IBMPlexMono-Medium.ttf IBMPlexMono-SemiBold.ttf OFL.txt)
  configure_file("${binary_dir}/Resources/Fonts/${font}"
    "${staging}/Resources/Fonts/${font}" COPYONLY)
endforeach()
configure_file("${repo}/LICENSE" "${staging}/LICENSE.txt" COPYONLY)
configure_file("${repo}/tracker/LICENSE" "${staging}/TRACKER-LICENSE.txt" COPYONLY)
configure_file("${repo}/THIRD_PARTY_NOTICES.md" "${staging}/THIRD_PARTY_NOTICES.md" COPYONLY)
configure_file("${repo}/plugins/common/TRACKER_WINDOWS_README.txt" "${staging}/README.txt" COPYONLY)
configure_file("${repo}/scripts/run-tracker-windows-check.cmd"
  "${staging}/run-windows-check.cmd" @ONLY NEWLINE_STYLE CRLF)
file(GLOB_RECURSE sources LIST_DIRECTORIES FALSE
  "${repo}/plugins/clap_tracker/*.cpp" "${repo}/plugins/clap_tracker/*.h"
  "${repo}/tracker/src/*.cpp" "${repo}/tracker/include/*.h")
set(provenance "Source SHA256 at cross-build packaging (worktree, not a release tag):\n")
foreach(source IN LISTS sources)
  file(SHA256 "${source}" hash)
  file(RELATIVE_PATH relative "${repo}" "${source}")
  string(APPEND provenance "${hash}  ${relative}\n")
endforeach()
file(WRITE "${staging}/SOURCE_PROVENANCE.txt" "${provenance}")
file(GLOB_RECURSE payload LIST_DIRECTORIES FALSE RELATIVE "${staging}" "${staging}/*")
list(SORT payload)
set(sums "")
foreach(relative IN LISTS payload)
  file(SHA256 "${staging}/${relative}" hash)
  string(APPEND sums "${hash}  ${relative}\n")
endforeach()
file(WRITE "${staging}/SHA256SUMS.txt" "${sums}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${staging}.zip" --format=zip "${name}"
  WORKING_DIRECTORY "${repo}/dist" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Windows test folder: ${staging}")
message(STATUS "Windows test ZIP: ${staging}.zip")
