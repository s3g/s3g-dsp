# Package the four migrated complex processors; never change installations.
cmake_minimum_required(VERSION 3.20)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED build_dir)
  set(build_dir "${repo}/build-clap-windows-cross")
endif()
find_program(objdump x86_64-w64-mingw32-objdump REQUIRED)
find_program(strip x86_64-w64-mingw32-strip REQUIRED)
file(STRINGS "${build_dir}/CMakeCache.txt" world_enabled REGEX "^S3G_ENABLE_WORLD:BOOL=ON$")
if(NOT world_enabled)
  message(FATAL_ERROR "Ambi Vox release packages require WORLD analysis/resynthesis enabled")
endif()
file(STRINGS "${repo}/scripts/clap-vstgui-complex-processors.tsv" rows)
set(entries "")
foreach(row IN LISTS rows)
  if(row MATCHES "^#" OR row STREQUAL "")
    continue()
  endif()
  string(REPLACE "\t" ";" fields "${row}")
  list(LENGTH fields count)
  if(NOT count EQUAL 4)
    message(FATAL_ERROR "Malformed complex-processor manifest row")
  endif()
  list(GET fields 0 relative)
  list(GET fields 1 canonical)
  if(NOT relative MATCHES "^clap_(no_input_mixer|acapella_source_synth|ambi_vox_encoder|ambi_imprint|formant_matrix)/s3g_(no_input_mixer|acapella_source_synth|ambi_vox_encoder|ambi_imprint|formant_matrix)[.]clap$" OR
      NOT canonical MATCHES "^s3g_(processor_no_input_mixer_8|processor_formant_matrix_2|ambi_encoder_vox_64|processor_ambi_imprint_64)[.]clap$")
    message(FATAL_ERROR "Unsafe complex-processor manifest path")
  endif()
  set(binary "${build_dir}/plugins/${relative}")
  execute_process(COMMAND "${objdump}" -p "${binary}" OUTPUT_VARIABLE pe
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0 OR NOT pe MATCHES "pei-x86-64" OR NOT pe MATCHES "clap_entry"
      OR pe MATCHES "DLL Name: (libgcc|libstdc[+][+]|libwinpthread)")
    message(FATAL_ERROR "Invalid Windows CLAP or external MinGW runtime: ${binary}\n${error}")
  endif()
  list(APPEND entries "${relative}|${canonical}")
endforeach()
list(LENGTH entries count)
if(NOT count EQUAL 4)
  message(FATAL_ERROR "Expected exactly four complex processor plugins")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
set(package_name "s3g-dsp-windows-complex-processors-x64-${stamp}")
set(staging "${repo}/dist/${package_name}")
if(EXISTS "${staging}" OR EXISTS "${staging}.zip")
  message(FATAL_ERROR "Refusing to overwrite an existing package")
endif()
file(MAKE_DIRECTORY "${staging}/Resources/Fonts")
set(sums "")
foreach(entry IN LISTS entries)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 relative)
  list(GET fields 1 canonical)
  configure_file("${build_dir}/plugins/${relative}" "${staging}/${canonical}" COPYONLY)
  execute_process(COMMAND "${strip}" --strip-unneeded "${staging}/${canonical}"
    COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${staging}/${canonical}" hash)
  string(APPEND sums "${hash}  ${canonical}\n")
endforeach()
foreach(font FiraCode-Regular.ttf FiraCode-LICENSE.txt)
  configure_file("${repo}/assets/fonts/${font}" "${staging}/Resources/Fonts/${font}" COPYONLY)
  file(SHA256 "${staging}/Resources/Fonts/${font}" hash)
  string(APPEND sums "${hash}  Resources/Fonts/${font}\n")
endforeach()
configure_file("${repo}/LICENSE" "${staging}/LICENSE.txt" COPYONLY)
configure_file("${repo}/THIRD_PARTY_NOTICES.md" "${staging}/THIRD_PARTY_NOTICES.md" COPYONLY)
configure_file("${repo}/plugins/common/COMPLEX_PROCESSORS_WINDOWS_README.txt" "${staging}/README.txt" COPYONLY)
file(GLOB atlas "${build_dir}/plugins/clap_ambi_imprint/Resources/Imprint Atlas/*.s3gimprint")
list(LENGTH atlas atlas_count)
if(NOT atlas_count EQUAL 19)
  message(FATAL_ERROR "Expected all 19 Imprint Atlas responses in the Windows build")
endif()
file(COPY ${atlas} DESTINATION "${staging}/Resources/Imprint Atlas")
foreach(license RapidJSON-LICENSE.txt WORLD-LICENSE.txt)
  configure_file("${build_dir}/plugins/clap_ambi_vox_encoder/Resources/Licenses/${license}"
    "${staging}/Resources/Licenses/${license}" COPYONLY)
endforeach()
# Hash documentation, licenses and optional import fixtures as well as binaries.
set(sums "")
file(GLOB_RECURSE payload LIST_DIRECTORIES FALSE RELATIVE "${staging}" "${staging}/*")
list(SORT payload)
foreach(relative IN LISTS payload)
  file(SHA256 "${staging}/${relative}" hash)
  string(APPEND sums "${hash}  ${relative}\n")
endforeach()
file(WRITE "${staging}/SHA256SUMS.txt" "${sums}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${staging}.zip" --format=zip "${package_name}"
  WORKING_DIRECTORY "${repo}/dist" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Windows folder: ${staging}")
message(STATUS "Windows archive: ${staging}.zip")
