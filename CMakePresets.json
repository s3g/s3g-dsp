{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "clap",
      "displayName": "CLAP",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap",
      "cacheVariables": {
        "S3G_BUILD_CLAP_PLUGIN": "ON"
      }
    },
    {
      "name": "clap-tracker",
      "displayName": "s3g Tracker CLAP Focused Build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-tracker",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_TRACKER_PREVIEW": "ON"
      }
    },
    {
      "name": "clap-release",
      "displayName": "CLAP Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_ENABLE_REALTIME_ALLOC_PROBE": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "ON",
        "S3G_BUILD_DRUM_OVERLOAD_PREVIEW": "OFF",
        "S3G_BUILD_TRACKER_PREVIEW": "ON",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "ON"
      }
    },
    {
      "name": "clap-sanitize",
      "displayName": "CLAP ASan + UBSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "ON",
        "S3G_BUILD_TRACKER_PREVIEW": "ON",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "ON"
      }
    },
    {
      "name": "apps",
      "displayName": "Standalone Apps",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-apps",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "S3G_BUILD_STANDALONE_APPS": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "OFF",
        "S3G_BUILD_TRACKER_PREVIEW": "OFF",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "clap",
      "configurePreset": "clap"
    },
    {
      "name": "clap-tracker",
      "configurePreset": "clap-tracker",
      "targets": [
        "s3g_tracker_clap",
        "s3g_tracker_timing_playback_scheduler_tests",
        "s3g_tracker_clap_smoke"
      ]
    },
    {
      "name": "clap-release",
      "configurePreset": "clap-release"
    },
    {
      "name": "clap-sanitize",
      "configurePreset": "clap-sanitize"
    },
    {
      "name": "apps",
      "configurePreset": "apps"
    }
  ]
}
