{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "clap",
      "displayName": "CLAP",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap",
      "cacheVariables": {
        "S3G_BUILD_CLAP_PLUGIN": "ON"
      }
    },
    {
      "name": "clap-tracker",
      "displayName": "s3g Tracker CLAP Focused Build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-tracker",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_TRACKER_PREVIEW": "ON"
      }
    },
    {
      "name": "clap-release",
      "displayName": "CLAP Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "S3G_ENABLE_PORTABLE_CLAP_GUI": "ON",
        "S3G_ENABLE_TRACKER_PORTABLE_SHELL_ON_MACOS": "ON",
        "S3G_ENABLE_SAMPLE_FAMILY_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_DRUM_FAMILY_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_TOPOLOGY_FAMILY_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_MEMORY_EFFECTS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_MONITORING_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_ROUTING_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_AMBI_BUS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_AMBI_EFFECTS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_DECODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_INPUT_ENCODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_MAP_ENCODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_CIRCUIT_ENCODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_RESONATOR_ENCODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_FEEDBACK_PROCESSORS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_MIDI_TOOLS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_COMPLEX_PROCESSORS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_STEREO_PROCESSORS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_SCORE_ENCODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_ENABLE_ENVIRONMENT_ENCODERS_VSTGUI_ON_MACOS": "ON",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_ENABLE_REALTIME_ALLOC_PROBE": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "ON",
        "S3G_BUILD_DRUM_OVERLOAD_PREVIEW": "OFF",
        "S3G_BUILD_TRACKER_PREVIEW": "ON",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "ON"
      }
    },
    {
      "name": "clap-sanitize",
      "displayName": "CLAP ASan + UBSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "ON",
        "S3G_BUILD_TRACKER_PREVIEW": "ON",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "ON"
      }
    },
    {
      "name": "apps",
      "displayName": "Experimental Standalone Apps (source only)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-apps",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "S3G_BUILD_STANDALONE_APPS": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "OFF",
        "S3G_BUILD_TRACKER_PREVIEW": "OFF",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "OFF"
      }
    },
    {
      "name": "clap-windows-pilot",
      "displayName": "Windows CLAP GUI Pilot",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-clap-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "OFF",
        "S3G_ENABLE_PORTABLE_CLAP_GUI": "ON",
        "S3G_ENABLE_WORLD": "OFF"
      }
    },
    {
      "name": "clap-windows-release",
      "displayName": "Experimental Windows x64 CLAP Prerelease (native MSVC)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-clap-windows-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_STANDALONE_APPS": "OFF",
        "S3G_BUILD_FUTURE_COMPONENTS": "ON",
        "S3G_BUILD_DRUM_OVERLOAD_PREVIEW": "OFF",
        "S3G_BUILD_TRACKER_PREVIEW": "ON",
        "S3G_BUILD_RELAY_PREVIEW": "ON",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "ON",
        "S3G_ENABLE_PORTABLE_CLAP_GUI": "ON",
        "S3G_ENABLE_WORLD": "ON"
      }
    },
    {
      "name": "clap-windows-cross",
      "displayName": "Windows CLAP GUI Pilots (Mac cross-build)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clap-windows-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "S3G_BUILD_CLAP_PLUGIN": "ON",
        "S3G_BUILD_FUTURE_COMPONENTS": "OFF",
        "S3G_BUILD_TRACKER_PREVIEW": "OFF",
        "S3G_BUILD_RELAY_PREVIEW": "OFF",
        "S3G_BUILD_BREAKBEAT_SLICER_PREVIEW": "OFF",
        "S3G_BUILD_SAMPLE_PLAYER_PREVIEW": "ON",
        "S3G_BUILD_SAMPLE_DOUBLES_PREVIEW": "ON",
        "S3G_BUILD_SAMPLE_WAVESETS_PREVIEW": "ON",
        "S3G_BUILD_SAMPLE_MOTION_PREVIEW": "ON",
        "S3G_BUILD_SAMPLE_LANES_PREVIEW": "ON",
        "S3G_BUILD_SAMPLE_GRAINS_PREVIEW": "ON",
        "S3G_BUILD_SAMPLE_CUTUPS_PREVIEW": "ON",
        "S3G_ENABLE_PORTABLE_CLAP_GUI": "ON",
        "S3G_ENABLE_WORLD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "clap",
      "configurePreset": "clap"
    },
    {
      "name": "clap-tracker",
      "configurePreset": "clap-tracker",
      "targets": [
        "s3g_tracker_clap",
        "s3g_tracker_timing_playback_scheduler_tests",
        "s3g_tracker_clap_smoke"
      ]
    },
    {
      "name": "clap-release",
      "configurePreset": "clap-release"
    },
    {
      "name": "clap-sanitize",
      "configurePreset": "clap-sanitize"
    },
    {
      "name": "apps",
      "configurePreset": "apps"
    },
    {
      "name": "clap-windows-pilot",
      "configurePreset": "clap-windows-pilot",
      "configuration": "Release",
      "targets": [
        "s3g_macro_delay_clap",
        "s3g_24ch_macro_delay_clap",
        "s3g_sample_player_clap",
        "s3g_ambi_point_encoder_clap",
        "s3g_ambi_stochastic_encoder_clap",
        "s3g_macro_delay_windows_clap_smoke"
      ]
    },
    {
      "name": "clap-windows-release",
      "configurePreset": "clap-windows-release",
      "configuration": "Release"
    },
    {
      "name": "clap-windows-cross",
      "configurePreset": "clap-windows-cross",
      "targets": [
        "s3g_macro_delay_clap",
        "s3g_sample_player_clap",
        "s3g_ambi_point_encoder_clap",
        "s3g_ambi_stochastic_encoder_clap"
      ]
    }
  ]
}
